# Copy to .env and fill in. Never commit .env.

# Gemini (Google AI Studio, free tier): claim extraction, Telugu/Hindi
# transcription fallback, on-screen text, plain-language summary.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-latest

# One Google Cloud API key with these APIs enabled:
#   Fact Check Tools API, YouTube Data API v3, Cloud Vision API (needs billing on)
GOOGLE_API_KEY=
# Or separate keys per API:
# FACTCHECK_API_KEY=
# YOUTUBE_API_KEY=
# VISION_API_KEY=

# Free-tier budgets the app enforces on itself
# GEMINI_DAILY_LIMIT=100
# FACTCHECK_DAILY_LIMIT=1000
# YOUTUBE_DAILY_UNITS=9000
# VISION_MONTHLY_UNITS=900
# VISION_ENABLED=true

# Local models (pip install -r backend/requirements-ml.txt)
# WHISPER_MODEL=base
# WHISPER_FALLBACK_MODEL=small
# OCR_ENGINE=auto          # auto | easyocr | tesseract | gemini | none
# USE_CLIP=false

# Thresholds (tune on the test set, not by guessing)
# STRONG_SIMILARITY=0.90
# WEAK_SIMILARITY=0.80
# FACTCHECK_MIN_RELEVANCE=0.34

# Limits
# MAX_VIDEO_SECONDS=90
# MAX_UPLOAD_MB=50

# API server (uvicorn app.main:app, from backend/)
# RATE_LIMIT_PER_DAY=10          # new analyses per client per day (cached results are free)
# TRUST_PROXY=false              # true behind Caddy / Cloudflare, to read X-Forwarded-For
# IP_HASH_SALT=                  # IPs are stored only as salted hashes; auto-generated if empty
# CORS_ORIGINS=                  # e.g. https://reelcheck.example (the Next.js frontend)
# PUBLIC_BASE_URL=               # e.g. https://reelcheck.example, for share-link previews
# EMBEDDED_WORKER=true           # false = run `python -m app.worker` as its own process
